/* 質問ごとの回答を保存する */
const answers = {};

/* 質問を表示する場所を取得する */
const questionsContainer = document.getElementById("questionsContainer");

/* 2ページ分の表示場所を作る */
const page1 = document.createElement("div");
const page2 = document.createElement("div");

page1.id = "page1";
page2.id = "page2";

page2.hidden = true;

questionsContainer.appendChild(page1);
questionsContainer.appendChild(page2);

/* 質問を1つずつ画面に追加する */
let questionNumber = 0;

questionGroups.forEach(function(group, groupIndex) {

    /* 何ページ目に表示するか決める */
    const targetPage = questionNumber < 10 ? page1 : page2;

    /* 分野の見出しを作る */
    const groupTitle = document.createElement("h2");
    groupTitle.textContent = group.title;
    targetPage.appendChild(groupTitle);

    /* 分野内の質問を表示する */
    group.questions.forEach(function(question) {
        questionNumber++;
        const currentQuestionNumber = questionNumber;

        const card = document.createElement("div");
        card.className = "question-card";

        const title = document.createElement("h3");
        title.textContent = "質問 " + questionNumber;
        card.appendChild(title);

        const text = document.createElement("p");
        text.textContent = question.text;
        card.appendChild(text);

        /* 質問9にケアマネジャーの注釈を追加する */
        if (question.annotation) {
            const term = document.createElement("span");
            term.className = "term";
            term.textContent = "ケアマネジャーとは？";

            const explanation = document.createElement("p");
            explanation.className = "annotation";
            explanation.textContent = question.annotation;
            explanation.hidden = true;

            term.addEventListener("click", function() {
                explanation.hidden = !explanation.hidden;
            });

            card.appendChild(term);
            card.appendChild(explanation);
        }

        /* 選択肢を作る */
        question.choices.forEach(function(choice) {
            const label = document.createElement("label");
            label.className = "answer-option";

            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.className = "answer-checkbox";

            const choiceText = document.createElement("span");
            choiceText.textContent = choice;

            label.appendChild(checkbox);
            label.appendChild(choiceText);

            checkbox.addEventListener("change", function() {
                const checkboxes =
                    card.querySelectorAll(".answer-checkbox");

                checkboxes.forEach(function(otherCheckbox) {
                    if (otherCheckbox !== checkbox) {
                        otherCheckbox.checked = false;
                    }
                });

                if (checkbox.checked) {
                    answers[currentQuestionNumber] = choice;
                } else {
                    delete answers[currentQuestionNumber];
                }
            });

            card.appendChild(label);
        });

        targetPage.appendChild(card);
    });
});

/* 途中保存するボタン */
const saveAnswers = document.getElementById("saveAnswers");
const saveMessage = document.getElementById("saveMessage");

saveAnswers.addEventListener("click", function() {
    const freeText = document.getElementById("freeText").value;

    const saveData = {
        answers: answers,
        freeText: freeText
    };

    localStorage.setItem("myNoteData", JSON.stringify(saveData));

    saveMessage.textContent = "回答を保存しました。";
});

/* 回答を確認するボタン */
const checkAnswers = document.getElementById("checkAnswers");

checkAnswers.addEventListener("click", function() {
    let result = "";
    let number = 0;

    questionGroups.forEach(function(group) {
        result += "\n【" + group.title + "】\n";

        group.questions.forEach(function(question) {
            number++;

            result += "質問" + number + "：" +
                (answers[number] || "未回答") + "\n";
        });
    });

    document.getElementById("answerMessage").textContent = result;
    document.getElementById("resultArea").hidden = false;

    document.getElementById("resultArea").scrollIntoView({
        behavior: "smooth"
    });
});

/* タイトル下の注釈を押すと説明を表示する */
const openExplanation = document.getElementById("openExplanation");

openExplanation.addEventListener("click", function() {
    const explanation = document.getElementById("acpExplanation");
    explanation.hidden = false;
    explanation.scrollIntoView({ behavior: "smooth", block: "nearest" });
});
/* ACPの説明を閉じるボタン */
const closeExplanation = document.getElementById("closeExplanation");

closeExplanation.addEventListener("click", function() {
    document.getElementById("acpExplanation").hidden = true;
});

/* 保存した回答を復元する */
const savedData = localStorage.getItem("myNoteData");

if (savedData !== null) {
    const saveData = JSON.parse(savedData);

    /* 保存した回答を復元する */
    Object.keys(saveData.answers).forEach(function(number) {
        answers[number] = saveData.answers[number];

        const cards = questionsContainer.querySelectorAll(".question-card");
        const card = cards[Number(number) - 1];

        if (card) {
            const checkboxes = card.querySelectorAll(".answer-checkbox");

            checkboxes.forEach(function(checkbox) {
                if (checkbox.nextElementSibling.textContent === saveData.answers[number]) {
                    checkbox.checked = true;
                }
            });
        }
    });

    /* 自由記述を復元する */
    document.getElementById("freeText").value = saveData.freeText || "";

    saveMessage.textContent = "保存した回答を復元しました。";
}
/* 回答をリセットする */
const resetAnswers = document.getElementById("resetAnswers");

resetAnswers.addEventListener("click", function() {
    if (confirm("回答をすべてリセットしますか？")) {
        /* 選択した回答を消す */
        document.querySelectorAll(".answer-checkbox").forEach(function(checkbox) {
            checkbox.checked = false;
        });

        /* 回答データを消す */
        Object.keys(answers).forEach(function(key) {
            delete answers[key];
        });

        /* 自由記述を消す */
        document.getElementById("freeText").value = "";

        /* 保存データを消す */
        localStorage.removeItem("myNoteData");

        /* 保存メッセージを消す */
        document.getElementById("saveMessage").textContent = "";

        /* 回答結果を隠す */
        document.getElementById("resultArea").hidden = true;
    }
});
/* ページ切り替え */
const nextPage = document.getElementById("nextPage");
const prevPage = document.getElementById("prevPage");

/* 次へボタン */
nextPage.addEventListener("click", function() {
    page1.hidden = true;
    page2.hidden = false;

    nextPage.hidden = true;
    prevPage.hidden = false;

    window.scrollTo(0, 0);
});

/* 戻るボタン */
prevPage.addEventListener("click", function() {
    page1.hidden = false;
    page2.hidden = true;

    nextPage.hidden = false;
    prevPage.hidden = true;

    window.scrollTo(0, 0);
});

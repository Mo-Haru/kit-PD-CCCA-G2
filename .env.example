# このファイルは秘密情報を含みません。
# 設定を変えるときだけ .env にコピーしてください。
# コピーしなくても、開発用の暫定値で起動します。
#
# PowerShell:
#   Copy-Item .env.example .env

# development または testing。production は未決定のため起動できません。
APP_ENV=development

# 開発用のダミーです。本番の秘密鍵ではありません。
SECRET_KEY=dev-change-me

# 未設定のときは instance/dev.db（SQLite・暫定）を使います。
# 本番データベースの決定ではありません。
# DATABASE_URL=sqlite:///C:/path/to/instance/dev.db

# パスキーのRP IDとオリジン。開発サーバーの初期値は localhost と http://localhost:5000。
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=意思の記録
# WEBAUTHN_ORIGIN=http://localhost:5000

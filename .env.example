# このファイルは秘密情報を含みません。
# 設定を変えるときだけ .env にコピーしてください。
# コピーしなくても、開発用の暫定値で起動します。
#
# PowerShell:
#   Copy-Item .env.example .env

# development または testing。production は未決定のため起動できません。
APP_ENV=development

# 開発用のダミーです。本番の秘密鍵ではありません。
SECRET_KEY=dev-change-me

# 旧形式のメール照合値を init-db で変換するときだけ使う秘密（メール招待は停止済み）。
# 32バイト以上のランダム値にしてください。未設定のときは弱い既定値へ落とさず、変換は失敗します。
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 値を変えると、保存済みの照合結果は再計算できません。
# CONTACT_HASH_KEY=

# 未設定のときは instance/dev.db（SQLite・暫定）を使います。
# 本番データベースの決定ではありません。
# DATABASE_URL=sqlite:///C:/path/to/instance/dev.db

# パスキーのRP IDとオリジン。開発サーバーの初期値は localhost と http://localhost:5000。
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=意思の記録
# WEBAUTHN_ORIGIN=http://localhost:5000

# アプリの手前にあるリバースプロキシの段数（nginxだけなら1）。回数制限の接続元の判定に使います。
# 直接受ける開発サーバーでは設定しないでください。設定するとX-Forwarded-Forを偽装できてしまいます。
# TRUSTED_PROXY_COUNT=

# LINE通知（docs/line-notice.md）。実際の秘密情報は .env にのみ設定してください。
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# 定期通知の送信先（友だち追加済みのテスト用ユーザー。Uから始まる33文字）
# LINE_TARGET_USER_ID=
# 毎日の通知時刻（日本時間・24時間表記）。変更後は flask line-schedule を起動し直す。
# DAILY_NOTIFICATION_TIME=18:00
# 通知から案内する回答画面のURLの元（例: https://example.com）。未設定なら WEBAUTHN_ORIGIN を使う。
# APP_BASE_URL=

/* ページ全体のデザイン */
body {
font-family: sans-serif;
font-size: 14px;
background-color: #f0f7ff;
color: #333333;
margin: 0;
padding: 20px;
}

/* タイトル */
h1 {
text-align: center;
color: #2864a8;
}

/* 質問の見出し */
h2 {
color: #2864a8;
margin-top: 30px;
}

/* 回答ボタン */
button {
display: block;
width: 100%;
padding: 15px;
margin: 12px 0;
font-size: 14px;
background-color: #ffffff;
color: #2864a8;
border: 2px solid #2864a8;
border-radius: 10px;
cursor: pointer;
}

/* ボタンを押すときの色 */
button {
background-color: #dcecff;
}
/* クリックできる専門用語 */
.term {
    color: #2864a8;
    text-decoration: underline;
    font-weight: bold;
    cursor: pointer;
}
/* ACPの説明欄 */
.explanation {
    background-color: #ffffff;
    border: 2px solid #2864a8;
    border-radius: 12px;
    padding: 20px;
    margin-top: 20px;
    line-height: 1.8;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
}

/* 説明欄の見出し */
.explanation h3 {
    color: #2864a8;
    margin-top: 0;
}

/* 説明欄の閉じるボタン */
#closeExplanation {
    background-color: #2864a8;
    color: #ffffff;
    border: none;
}
/* 選択した回答ボタン */
button.selected {
    background-color: #2864a8;
    color: #ffffff;
    border-color: #2864a8;
}
/* hiddenが指定された要素を非表示にする */
[hidden] {
    display: none !important;
}
#answerMessage {
    white-space: pre-line;
}
/* 質問カード */
.question-card {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 16px;
    margin: 20px 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

/* 質問カード内の回答ボタン */
.question-card .answer-button {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 12px;
    margin: 10px 0;
    text-align: center;
    background-color: #ffffff;
    color: #2864a8;
    border: 2px solid #2864a8;
    border-radius: 10px;
}

/* 選択した回答ボタン */
.question-card .answer-button.selected {
    background-color: #2864a8;
    color: #ffffff;
}
/* 選択肢全体 */
.answer-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    margin: 10px 0;
    background-color: #ffffff;
    border: 1px solid #cbd9e8;
    border-radius: 8px;
    cursor: pointer;
}

/* 丸い選択欄 */
.answer-checkbox {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    accent-color: #2864a8;
    cursor: pointer;
    appearance: none;
    border: 2px solid #2864a8;
    border-radius: 50%;
    background-color: #ffffff;
}

/* 選択したときに丸の中を青くする */
.answer-checkbox:checked {
    background-color: #2864a8;
    box-shadow: inset 0 0 0 4px #ffffff;
}

/* 選択肢の文字 */
.answer-option span {
    font-size: 14px;
    color: #333333;
}

/* 選択中の選択肢 */
.answer-option:has(input:checked) {
    background-color: #e5f0ff;
    border-color: #2864a8;
}
/* スマートフォン画面への対応 */
* {
    box-sizing: border-box;
}

body {
    width: 100%;
    max-width: 100%;
    padding: 16px;
    overflow-wrap: break-word;
}

.question-card,
.explanation {
    width: 100%;
    max-width: 100%;
}

textarea {
    width: 100%;
    max-width: 100%;
    padding: 12px;
    font-size: 16px;
    box-sizing: border-box;
}

button {
    box-sizing: border-box;
    max-width: 100%;
}
/* 注釈が付いている単語 */
.term {
    color: #2864a8;
    font-weight: bold;
    text-decoration: underline;
    cursor: pointer;
}
